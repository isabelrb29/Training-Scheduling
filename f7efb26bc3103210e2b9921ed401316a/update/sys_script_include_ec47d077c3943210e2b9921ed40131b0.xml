        <script><![CDATA[var ScheduleValidation = Class.create();
ScheduleValidation.prototype = Object.extendsObject(global.AbstractAjaxProcessor, {
    checkDuplicate: function() {
        var course = this.getParameter('sysparm_course');
        var date = this.getParameter('sysparm_date');

        var scheduleGR = new GlideRecord('x_1131775_traini_0_schedules');
        scheduleGR.addQuery('course', course);
        scheduleGR.addQuery('training_date', date);
		scheduleGR.setLimit(1);
        scheduleGR.query();

        if (scheduleGR.hasNext()) {
            return "false";
        }

        return "true";
    },

    type: 'ScheduleValidation'

});]]></script>
