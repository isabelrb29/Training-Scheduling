        <name>Update Enrollment</name>
        <onclick/>
        <order>100</order>
        <script><![CDATA[	var enrollmentGR = new GlideRecord("x_1131775_traini_0_enrollment");
	enrollmentGR.initialize();
	enrollmentGR.training_schedule.course = current.getValue('course');
	enrollmentGR.training_date = current.getValue('training_schedule.training_date');
	enrollmentGR.opened_by = current.getValue('opened_by');
	enrollmentGR.training_schedule.instructor = current.getValue('training_schedule.instructor');
	enrollmentGR.state = 3;
	enrollmentGR.insert();

	var capacityGR = new GlideRecord("x_1131775_traini_0_enrollment");
	capacityGR.addQuery('training_schedule', current.getValue("training_schedule"));
	capacityGR.query();

	var total = 0;
	while (capacityGR.next()) {
		total++;
	}

	if (total > current.capacity) {
		current.setValue('capacity', 'total');
		capacityGR.update();
	}]]></script>
